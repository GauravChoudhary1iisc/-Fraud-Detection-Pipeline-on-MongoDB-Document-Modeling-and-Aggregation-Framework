{
  "indexes": [
    {
      "name": "amount_class",
      "keys": [
        [
          "Amount",
          1
        ],
        [
          "Class",
          1
        ]
      ]
    },
    {
      "name": "time",
      "keys": [
        [
          "Time",
          1
        ]
      ]
    }
  ],
  "workloads": {
    "find_amount_range": {
      "kind": "find",
      "spec": {
        "Amount": {
          "$gte": 1000,
          "$lt": 2000
        }
      }
    },
    "find_time_window": {
      "kind": "find",
      "spec": {
        "Time": {
          "$gte": 36000,
          "$lt": 39600
        }
      }
    },
    "agg_amount_bins_high_value": {
      "kind": "agg",
      "spec": [
        {
          "$match": {
            "Amount": {
              "$gte": 500
            }
          }
        },
        {
          "$bucket": {
            "groupBy": "$Amount",
            "boundaries": [
              0,
              1,
              10,
              50,
              100,
              250,
              500,
              1000,
              2500,
              5000
            ],
            "default": "5000+",
            "output": {
              "n": {
                "$sum": 1
              },
              "frauds": {
                "$sum": "$Class"
              },
              "avg_amount": {
                "$avg": "$Amount"
              }
            }
          }
        },
        {
          "$addFields": {
            "fraud_rate": {
              "$divide": [
                "$frauds",
                "$n"
              ]
            }
          }
        }
      ]
    },
    "agg_hourly_counts_first_6h": {
      "kind": "agg",
      "spec": [
        {
          "$match": {
            "Time": {
              "$lt": 21600
            }
          }
        },
        {
          "$group": {
            "_id": {
              "$floor": {
                "$divide": [
                  "$Time",
                  3600
                ]
              }
            },
            "n": {
              "$sum": 1
            },
            "frauds": {
              "$sum": "$Class"
            },
            "total_amount": {
              "$sum": "$Amount"
            }
          }
        },
        {
          "$setWindowFields": {
            "sortBy": {
              "_id": 1
            },
            "output": {
              "rolling_3h_n": {
                "$sum": "$n",
                "window": {
                  "documents": [
                    -2,
                    0
                  ]
                }
              },
              "rolling_3h_frauds": {
                "$sum": "$frauds",
                "window": {
                  "documents": [
                    -2,
                    0
                  ]
                }
              }
            }
          }
        },
        {
          "$project": {
            "_id": 0,
            "hour_index": "$_id",
            "hour_of_day": {
              "$mod": [
                "$_id",
                24
              ]
            },
            "n": 1,
            "frauds": 1,
            "total_amount": {
              "$round": [
                "$total_amount",
                2
              ]
            },
            "rolling_3h_n": 1,
            "rolling_3h_frauds": 1
          }
        }
      ]
    },
    "agg_class_amount_stats_gt_1000": {
      "kind": "agg",
      "spec": [
        {
          "$match": {
            "Amount": {
              "$gt": 1000
            }
          }
        },
        {
          "$group": {
            "_id": "$Class",
            "n": {
              "$sum": 1
            },
            "Amount_mean": {
              "$avg": "$Amount"
            },
            "Amount_std": {
              "$stdDevSamp": "$Amount"
            }
          }
        },
        {
          "$sort": {
            "_id": 1
          }
        }
      ]
    },
    "agg_amount_bins_full_collection": {
      "kind": "agg",
      "spec": [
        {
          "$bucket": {
            "groupBy": "$Amount",
            "boundaries": [
              0,
              1,
              10,
              50,
              100,
              250,
              500,
              1000,
              2500,
              5000
            ],
            "default": "5000+",
            "output": {
              "n": {
                "$sum": 1
              },
              "frauds": {
                "$sum": "$Class"
              },
              "avg_amount": {
                "$avg": "$Amount"
              }
            }
          }
        },
        {
          "$addFields": {
            "fraud_rate": {
              "$divide": [
                "$frauds",
                "$n"
              ]
            }
          }
        }
      ]
    }
  },
