  "per_transaction_features": [
    {
      "$setWindowFields": {
        "sortBy": {
          "Time": 1
        },
        "output": {
          "tx_count_prev_1h": {
            "$count": {},
            "window": {
              "range": [
                -3600,
                0
              ]
            }
          },
          "tx_count_prev_10m": {
            "$count": {},
            "window": {
              "range": [
                -600,
                0
              ]
            }
          },
          "amount_mean_prev_1h": {
            "$avg": "$Amount",
            "window": {
              "range": [
                -3600,
                0
              ]
            }
          }
        }
      }
    },
    {
      "$addFields": {
        "hour_of_day": {
          "$mod": [
            {
              "$floor": {
                "$divide": [
                  "$Time",
                  3600
                ]
              }
            },
            24
          ]
        },
        "log_amount": {
          "$ln": {
            "$add": [
              "$Amount",
              1
            ]
          }
        },
        "amount_vs_1h_mean": {
          "$divide": [
            "$Amount",
            {
              "$max": [
                "$amount_mean_prev_1h",
                0.01
              ]
            }
          ]
        },
        "amount_bin": {
          "$size": {
            "$filter": {
              "input": [
                1,
                10,
                50,
                100,
                250,
                500,
                1000,
                2500,
                5000
              ],
              "cond": {
                "$gte": [
                  "$Amount",
                  "$$this"
                ]
              }
            }
          }
        }
      }
    },
    {
      "$out": "features"
    }
  ]
}