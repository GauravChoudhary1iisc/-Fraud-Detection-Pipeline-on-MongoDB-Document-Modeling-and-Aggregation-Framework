{
  "amount_bin_fraud_rate": [
    {
      "$bucket": {
        "groupBy": "$Amount",
        "boundaries": [
          0,
          1,
          10,
          50,
          100,
          250,
          500,
          1000,
          2500,
          5000
        ],
        "default": "5000+",
        "output": {
          "n": {
            "$sum": 1
          },
          "frauds": {
            "$sum": "$Class"
          },
          "avg_amount": {
            "$avg": "$Amount"
          }
        }
      }
    },
    {
      "$addFields": {
        "fraud_rate": {
          "$divide": [
            "$frauds",
            "$n"
          ]
        }
      }
    }
  ],
  "hourly_window_counts": [
    {
      "$group": {
        "_id": {
          "$floor": {
            "$divide": [
              "$Time",
              3600
            ]
          }
        },
        "n": {
          "$sum": 1
        },
        "frauds": {
          "$sum": "$Class"
        },
        "total_amount": {
          "$sum": "$Amount"
        }
      }
    },
    {
      "$setWindowFields": {
        "sortBy": {
          "_id": 1
        },
        "output": {
          "rolling_3h_n": {
            "$sum": "$n",
            "window": {
              "documents": [
                -2,
                0
              ]
            }
          },
          "rolling_3h_frauds": {
            "$sum": "$frauds",
            "window": {
              "documents": [
                -2,
                0
              ]
            }
          }
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "hour_index": "$_id",
        "hour_of_day": {
          "$mod": [
            "$_id",
            24
          ]
        },
        "n": 1,
        "frauds": 1,
        "total_amount": {
          "$round": [
            "$total_amount",
            2
          ]
        },
        "rolling_3h_n": 1,
        "rolling_3h_frauds": 1
      }
    }
  ],
